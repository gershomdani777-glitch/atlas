# Local dev defaults — the code falls back to these if unset, so this file
# is only needed for production overrides.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# On Vercel: set both in Project Settings -> Environment Variables BEFORE
# the first build (they're inlined into the JS bundle at build time, not
# read at runtime — a late change needs a redeploy to take effect). Use
# wss:// (not ws://) once the backend is served over HTTPS, e.g.:
#   NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
#   NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com/ws/live
