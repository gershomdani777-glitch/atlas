# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string (Session pooler or direct, with pgvector enabled)
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Upstash Redis connection string (use rediss:// for TLS)
REDIS_URL=rediss://default:password@xxxxx.upstash.io:6379

# Google AI Studio free-tier key (aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_TIMEOUT_SECONDS=20

# Market data ingestion
BINANCE_WS_BASE=wss://stream.binance.com:9443
ASSET_UNIVERSE=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,dogeusdt
DEPTH_STREAM_LEVELS=20
STALENESS_TTL_SECONDS=10
REDIS_WRITE_INTERVAL_SECONDS=4.0

# Agent loop
AGENT_CYCLE_SECONDS=30
MEMORY_TOP_K=3

# Default risk config (seeded once; edit live afterwards via /config/risk)
DEFAULT_MAX_POSITION_PCT=0.12
DEFAULT_MAX_EXPOSURE_PCT=0.45
DEFAULT_MAX_ASSET_EXPOSURE_PCT=0.20
DEFAULT_DRAWDOWN_STOP_PCT=0.08
DEFAULT_KELLY_FRACTION=0.25
DEFAULT_MIN_EDGE_OVER_COST_BPS=8.0
STARTING_CAPITAL=100000.0

# API
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
